@using FlowerShop.Domain.Entities.Orders
@using FlowerShop.Web.Helpers
@model FlowerShop.Application.Features.Orders.Queries.GetOrderReceipt.OrderReceiptDto

<div id="receipt-modal-backdrop" 
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 overflow-y-auto"
     onclick="if(event.target === this) document.getElementById('modal-container').innerHTML = ''">
    
    <div class="relative bg-white rounded-3xl shadow-2xl max-w-2xl w-full my-8 overflow-hidden animate-in fade-in zoom-in-95 duration-200" onclick="event.stopPropagation()">
        
        <div class="gradient-red px-6 py-5 flex items-center justify-between text-white">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center border border-white/20">
                    <i class="fa-solid fa-receipt text-xl text-white"></i>
                </div>
                <div>
                    <h3 class="font-bold text-lg text-white">Elektronski račun & Detalji porudžbine</h3>
                    <p class="text-xs text-red-100 font-mono">@Model.OrderNumber</p>
                </div>
            </div>
            <button type="button" 
                    onclick="document.getElementById('modal-container').innerHTML = ''" 
                    class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors cursor-pointer">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <div class="p-6 max-h-[75vh] overflow-y-auto space-y-6">

            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 p-4 bg-red-50/70 rounded-2xl border border-red-100">
                <div>
                    <h4 class="font-bold text-red-950 text-base">Cvećara Nikolić d.o.o.</h4>
                    <p class="text-xs text-gray-500">Kralja Petra 45, 11000 Beograd</p>
                    <p class="text-xs text-gray-500">Datum izdavanja: <span class="font-semibold text-gray-700">@Model.CreatedAt.ToString("dd.MM.yyyy. u HH:mm")</span></p>
                </div>
                <div class="flex flex-wrap sm:flex-col items-end gap-2">
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-gray-500">Status porudžbine:</span>
                        @switch (Model.OrderStatus)
                        {
                            case OrderStatus.Pending:
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">Na čekanju</span>
                                break;
                            case OrderStatus.Confirmed:
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200">Potvrđeno</span>
                                break;
                            case OrderStatus.Completed:
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">Završeno</span>
                                break;
                            case OrderStatus.Cancelled:
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-gray-100 text-gray-700 border border-gray-300">Otkazano</span>
                                break;
                            default:
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-gray-100 text-gray-800">@Model.OrderStatus.GetDisplayName()</span>
                                break;
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-gray-500">Status dostave:</span>
                        <span class="text-xs font-semibold text-red-900 bg-red-100/80 px-2 py-0.5 rounded-md">@Model.DeliveryStatus.GetDisplayName()</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div class="p-4 bg-gray-50 rounded-2xl border border-gray-200/80 flex flex-col gap-1.5">
                    <span class="font-bold uppercase tracking-wider text-gray-400 text-[10px] flex items-center gap-1.5">
                        <i class="fa-solid fa-user text-red-700"></i> Naručilac (Kupac)
                    </span>
                    <p class="font-bold text-sm text-gray-900">@Model.BuyerFullName</p>
                    <p class="text-gray-600"><i class="fa-regular fa-envelope mr-1 text-gray-400"></i>@Model.BuyerEmail</p>
                    @if (!string.IsNullOrWhiteSpace(Model.BuyerPhoneNumber))
                    {
                        <p class="text-gray-600"><i class="fa-solid fa-phone mr-1 text-gray-400"></i>@Model.BuyerPhoneNumber</p>
                    }
                </div>

                <div class="p-4 bg-red-50/50 rounded-2xl border border-red-100 flex flex-col gap-1.5">
                    <span class="font-bold uppercase tracking-wider text-red-400 text-[10px] flex items-center gap-1.5">
                        <i class="fa-solid fa-location-dot text-red-700"></i> Primalac i dostava
                    </span>
                    <p class="font-bold text-sm text-red-950">@Model.RecipientFullName</p>
                    <p class="text-gray-700"><i class="fa-solid fa-house mr-1 text-red-400"></i>@Model.OrderAddress, @Model.ZipCode @Model.City</p>
                    <p class="text-gray-700"><i class="fa-solid fa-phone mr-1 text-red-400"></i>@Model.RecipientPhoneNumber</p>
                    <p class="text-red-900 font-semibold mt-0.5">
                        <i class="fa-regular fa-calendar-check mr-1 text-red-700"></i>Željena dostava: @Model.OrderDate.ToString("dd.MM.yyyy. u HH:mm")
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <div class="p-4 bg-pink-50/80 rounded-2xl border border-pink-200 flex flex-col gap-1">
                    <span class="font-bold uppercase tracking-wider text-pink-700 text-[10px] flex items-center gap-1.5">
                        <i class="fa-solid fa-heart text-pink-600"></i> Poruka na čestitki / Napomena
                    </span>
                    <p class="text-sm italic text-pink-950 font-medium pl-2 border-l-2 border-pink-400">
                        "@Model.Note"
                    </p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.DelivererFullName))
            {
                <div class="p-3 bg-blue-50 rounded-xl border border-blue-100 flex items-center justify-between text-xs text-blue-950">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-truck text-blue-600"></i>
                        <span>Dodeljeni dostavljač: <strong>@Model.DelivererFullName</strong></span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.DelivererPhoneNumber))
                    {
                        <span class="text-blue-800 font-medium">@Model.DelivererPhoneNumber</span>
                    }
                </div>
            }

            <div class="border border-red-200/80 rounded-2xl overflow-hidden">
                <table class="w-full text-left text-xs">
                    <thead class="bg-red-200/50 text-red-950 font-bold uppercase text-[10px] tracking-wider">
                    <tr>
                        <th class="p-3">Artikal</th>
                        <th class="p-3 text-center">Količina</th>
                        <th class="p-3 text-right">Cena</th>
                        <th class="p-3 text-right">Ukupno</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-red-100 text-gray-700">
                    @foreach (var item in Model.Items)
                    {
                        <tr class="hover:bg-red-50/30 transition-colors">
                            <td class="p-3 flex items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(item.ProductImagePath))
                                {
                                    <img src="@item.ProductImagePath" alt="@item.ProductName" class="w-10 h-10 rounded-lg object-cover border border-red-200 shadow-sm shrink-0" />
                                }
                                <span class="font-semibold text-red-950 text-sm">@item.ProductName</span>
                            </td>
                            <td class="p-3 text-center font-bold text-gray-800">@item.Quantity</td>
                            <td class="p-3 text-right whitespace-nowrap">@item.UnitPrice.ToString("N0") RSD</td>
                            <td class="p-3 text-right font-bold text-red-950 whitespace-nowrap">@item.TotalPrice.ToString("N0") RSD</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="flex flex-col gap-2 bg-red-100/50 p-4 rounded-2xl border border-red-200 text-xs">
                <div class="flex justify-between text-gray-700">
                    <span>Međuzbir:</span>
                    <span class="font-semibold text-gray-900">@Model.Subtotal.ToString("N0") RSD</span>
                </div>
                <div class="flex justify-between text-gray-700">
                    <span>Troškovi dostave:</span>
                    <span class="font-semibold text-gray-900">@Model.DeliveryFee.ToString("N0") RSD</span>
                </div>
                <div class="border-t border-red-200 pt-2 flex justify-between items-center text-base font-bold text-red-950">
                    <span>UKUPNO ZA UPLATU:</span>
                    <span class="text-lg text-red-900 font-extrabold">@Model.TotalPrice.ToString("N0") RSD</span>
                </div>
                <div class="flex items-center gap-1.5 text-[11px] text-emerald-700 font-semibold mt-1">
                    <i class="fa-solid fa-shield-check"></i>
                    <span>Plaćeno karticom online • Sigurna transakcija</span>
                </div>
            </div>

        </div>

        <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-between">
            <button type="button"
                    onclick="window.print()"
                    class="px-4 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-100 transition-colors flex items-center gap-2 cursor-pointer shadow-sm">
                <i class="fa-solid fa-print"></i>
                <span>Štampaj račun</span>
            </button>

            <button type="button"
                    onclick="document.getElementById('modal-container').innerHTML = ''"
                    class="px-5 py-2 text-xs font-semibold text-white gradient-red rounded-xl hover:opacity-95 transition-opacity cursor-pointer shadow-md">
                Zatvori
            </button>
        </div>

    </div>
</div>
