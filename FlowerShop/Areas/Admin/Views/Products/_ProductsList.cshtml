@using FlowerShop.SharedKernel.Results
@model PagedResult<FlowerShop.Web.Areas.Admin.Models.Products.ProductListViewModel>

<div class="overflow-x-auto w-full bg-red-100/40">
    <table class="w-full text-left">
        <thead class="bg-red-200/60 text-red-900 uppercase text-[10px] font-bold tracking-widest">
        <tr>
            <th class="p-4">Proizvod</th>
            <th class="p-4 hidden md:table-cell">Kategorija</th>
            <th class="p-4 hidden lg:table-cell">Cveće</th>
            <th class="p-4 hidden xl:table-cell">Prilike</th>
            <th class="p-4 text-right">Cena</th>
            <th class="p-4 text-center hidden sm:table-cell">Zaliha</th>
            <th class="p-4 text-center hidden md:table-cell">Status</th>
            <th class="p-4 text-center">Akcije</th>
        </tr>
        </thead>
        <tbody class="text-gray-700 divide-y divide-red-200 text-sm">
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="8" class="p-20 text-center">
                    <div class="flex flex-col items-center justify-center gap-4">
                        <div class="w-24 h-24 bg-red-100 rounded-full flex items-center justify-center">
                            <i class="fa-solid fa-seedling text-5xl text-red-300"></i>
                        </div>
                        <div class="space-y-1">
                            <h3 class="text-2xl font-bold text-red-900">Nema pronađenih proizvoda</h3>
                            <p class="text-gray-500">Pokušajte sa drugačijim filterima ili dodajte novi proizvod.</p>
                        </div>
                    </div>
                </td>
            </tr>
        }
        @foreach (var product in Model.Items)
        {
            <tr class="hover:bg-red-50/50 transition-colors">
                <td class="p-4">
                    <div class="flex items-center gap-3">
                        <img src="@product.ProductImage" alt="@product.Name" class="w-12 h-12 rounded-lg object-cover border border-red-200 shadow-sm" />
                        <div>
                            <p class="font-semibold text-red-900">@product.Name</p>
                            <p class="text-xs text-gray-400 mt-0.5 max-w-[180px] truncate">@product.Description</p>
                            <div class="md:hidden mt-1">
                                <span class="text-[10px] bg-red-50 text-red-600 px-2 py-0.5 rounded border border-red-100">@product.CategoryName</span>
                            </div>
                        </div>
                    </div>
                </td>
                <td class="p-4 hidden md:table-cell">
                    <span class="text-xs bg-red-100 text-red-700 font-semibold px-2 py-1 rounded-full border border-red-200">@product.CategoryName</span>
                </td>
                <td class="p-4 hidden lg:table-cell">
                    <div class="flex flex-wrap gap-1">
                        @foreach (var flower in product.FlowerNames.Take(2))
                        {
                            <span class="text-xs bg-orange-100 text-orange-700 font-medium px-2 py-0.5 rounded-full">@flower</span>
                        }
                        @if (product.FlowerNames.Count > 2)
                        {
                            <span class="text-xs bg-gray-100 text-gray-500 font-medium px-2 py-0.5 rounded-full">+@(product.FlowerNames.Count - 2)</span>
                        }
                    </div>
                </td>
                <td class="p-4 hidden xl:table-cell">
                    <div class="flex flex-wrap gap-1">
                        @foreach (var occasion in product.Occasions.Take(2))
                        {
                            <span class="text-xs bg-pink-100 text-pink-700 font-medium px-2 py-0.5 rounded-full">@occasion</span>
                        }
                        @if (product.Occasions.Count > 2)
                        {
                            <span class="text-xs bg-gray-100 text-gray-500 font-medium px-2 py-0.5 rounded-full">+@(product.Occasions.Count - 2)</span>
                        }
                    </div>
                </td>
                <td class="p-4 text-right font-bold text-red-900 whitespace-nowrap">
                    <div>@product.Price.ToString("N2") RSD</div>
                    <div class="sm:hidden text-[10px] font-medium text-gray-400">@product.Stock na stanju</div>
                </td>
                <td class="p-4 text-center hidden sm:table-cell">
                    @if (product.Stock > 10)
                    {
                        <span class="text-xs font-bold text-green-700 bg-green-100 px-2 py-1 rounded-full">@product.Stock</span>
                    }
                    else if (product.Stock > 0)
                    {
                        <span class="text-xs font-bold text-orange-700 bg-orange-100 px-2 py-1 rounded-full">@product.Stock</span>
                    }
                    else
                    {
                        <span class="text-xs font-bold text-red-700 bg-red-100 px-2 py-1 rounded-full">0</span>
                    }
                </td>
                <td class="p-4 text-center hidden md:table-cell">
                    @if (!product.IsDeleted)
                    {
                        <span class="badge new text-[10px] p-1 px-3">Aktivan</span>
                    }
                    else
                    {
                        <span class="badge out-of-stock text-[10px] p-1 px-3">Arhiviran</span>
                    }
                </td>
                <td class="p-4 text-center">
                    <div class="flex justify-center gap-2">
                        <a hx-get="@Url.Action("Edit", "Products", new { area = "Admin", id = product.Id })"
                           hx-target="#user-content"
                           hx-push-url="true"
                           title="Izmeni" 
                           class="p-2 rounded-lg bg-orange-100 hover:bg-orange-200 text-orange-700 transition-colors cursor-pointer">
                            <i class="fa-solid fa-pen text-xs"></i>
                        </a>
                        <a href="#" title="Detalji" class="p-2 rounded-lg bg-red-100 hover:bg-red-200 text-red-700 transition-colors">
                            <i class="fa-solid fa-eye text-xs"></i>
                        </a>
                        @if (!product.IsDeleted)
                        {
                            <a href="#" title="Arhiviraj" class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors">
                                <i class="fa-solid fa-box-archive text-xs"></i>
                            </a>
                        }
                        else
                        {
                            <a href="#" title="Vrati" class="p-2 rounded-lg bg-green-100 hover:bg-green-200 text-green-700 transition-colors">
                                <i class="fa-solid fa-rotate-left text-xs"></i>
                            </a>
                        }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="px-5 py-4 bg-red-50 border-t border-red-100 flex flex-col sm:flex-row justify-between items-center gap-3 text-sm text-gray-600">
        <span>Stranica <span class="font-bold text-red-900">@Model.Page</span> od <span class="font-bold text-red-900">@Model.TotalPages</span> &mdash; ukupno <span class="font-bold text-red-900">@Model.TotalCount</span> proizvoda</span>
        <div class="flex gap-1">
            @if (Model.Page > 1)
            {
                <a href="?pageIndex=@(Model.Page - 1)" class="px-3 py-1.5 rounded-lg bg-white border border-red-200 hover:bg-red-100 text-red-700 font-semibold transition-colors">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                </a>
            }
            @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
            {
                if (i == Model.Page)
                {
                    <span class="px-3 py-1.5 rounded-lg gradient-red text-white font-bold text-xs">@i</span>
                }
                else
                {
                    <a href="?pageIndex=@i" class="px-3 py-1.5 rounded-lg bg-white border border-red-200 hover:bg-red-100 text-red-700 font-semibold text-xs transition-colors">@i</a>
                }
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a href="?pageIndex=@(Model.Page + 1)" class="px-3 py-1.5 rounded-lg bg-white border border-red-200 hover:bg-red-100 text-red-700 font-semibold transition-colors">
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </a>
            }
        </div>
    </div>
}

