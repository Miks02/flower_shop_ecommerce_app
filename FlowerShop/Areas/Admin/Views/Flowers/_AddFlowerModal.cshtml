@using FlowerShop.Domain.Enums
@using FlowerShop.Web.Helpers
@model FlowerShop.Web.Areas.Admin.Models.Flowers.AddFlowerViewModel

<div id="add-flower-modal-backdrop" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="relative bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden">
        <div class="gradient-red px-6 py-4 flex items-center justify-between text-white">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-seedling text-lg"></i>
                <h3 class="font-bold text-lg text-white">Dodaj novi cvet</h3>
            </div>
            <button type="button"
                    onclick="document.getElementById('modal-container').innerHTML = ''"
                    class="text-white/80 hover:text-white transition-colors cursor-pointer">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form method="post"
              action="@Url.Action("Create", "Flowers", new { area = "Admin" })"
              hx-post="@Url.Action("Create", "Flowers", new { area = "Admin" })"
              hx-target="#modal-container"
              hx-swap="innerHTML"
              hx-on::after-request="if(event.detail.successful) document.getElementById('modal-container').innerHTML = ''"
              class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.SelectedFlowersJson)

            <div>
                @Html.LabelFor(m => m.Name, "Naziv cveta", new { @class = "block text-sm font-semibold text-red-900 mb-1 font-secondary tracking-wide uppercase text-[10px]" })
                @Html.TextBoxFor(m => m.Name, new { @class = "w-full px-4 py-2 rounded-lg border border-red-200 focus:outline-none focus:ring-2 focus:ring-red-300 text-gray-700 bg-white/50", placeholder = "Unesite naziv cveta..." })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-red-500 text-xs mt-1" })
            </div>

            <div>
                @Html.LabelFor(m => m.Color, "Boja", new { @class = "block text-sm font-semibold text-red-900 mb-1 font-secondary tracking-wide uppercase text-[10px]" })
                @Html.TextBoxFor(m => m.Color, new { @class = "w-full px-4 py-2 rounded-lg border border-red-200 focus:outline-none focus:ring-2 focus:ring-red-300 text-gray-700 bg-white/50", placeholder = "Unesite boju cveta..." })
                @Html.ValidationMessageFor(m => m.Color, "", new { @class = "text-red-500 text-xs mt-1" })
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    @Html.LabelFor(m => m.FlowerCategory, "Kategorija", new { @class = "block text-sm font-semibold text-red-900 mb-1 font-secondary tracking-wide uppercase text-[10px]" })
                    @Html.DropDownListFor(m => m.FlowerCategory,
                        new SelectList(Enum.GetValues(typeof(FlowerCategory)).Cast<FlowerCategory>().Select(c => new { Id = (int)c, Name = c.GetDisplayName() }), "Id", "Name"),
                        new { @class = "w-full px-4 py-2 rounded-lg border border-red-200 focus:outline-none focus:ring-2 focus:ring-red-300 text-gray-700 bg-white/50" })
                    @Html.ValidationMessageFor(m => m.FlowerCategory, "", new { @class = "text-red-500 text-xs mt-1" })
                </div>
                <div>
                    @Html.LabelFor(m => m.Stock, "Zaliha", new { @class = "block text-sm font-semibold text-red-900 mb-1 font-secondary tracking-wide uppercase text-[10px]" })
                    @Html.TextBoxFor(m => m.Stock, new { @class = "w-full px-4 py-2 rounded-lg border border-red-200 focus:outline-none focus:ring-2 focus:ring-red-300 text-gray-700 bg-white/50", type = "number" })
                    @Html.ValidationMessageFor(m => m.Stock, "", new { @class = "text-red-500 text-xs mt-1" })
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-red-100">
                <button type="button"
                        onclick="document.getElementById('modal-container').innerHTML = ''"
                        class="px-4 py-2 text-xs font-semibold text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 transition-colors cursor-pointer">
                    Otkaži
                </button>
                <button type="submit"
                        class="px-4 py-2 text-xs font-semibold text-white bg-orange-500 hover:bg-orange-600 rounded-lg shadow-md transition-colors flex items-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-plus text-xs"></i>
                    <span>Sačuvaj cvet</span>
                </button>
            </div>
        </form>
    </div>
</div>
