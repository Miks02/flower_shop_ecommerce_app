@model FlowerShop.Web.Areas.Admin.Models.Flowers.UpdateFlowerStockViewModel

<div id="update-stock-modal-backdrop" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="relative bg-white rounded-2xl shadow-2xl max-w-sm w-full overflow-hidden">
        <div class="gradient-red px-6 py-4 flex items-center justify-between text-white">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-boxes-stacked text-lg"></i>
                <h3 class="font-bold text-lg text-white">Ažuriraj zalihu</h3>
            </div>
            <button type="button"
                    onclick="document.getElementById('modal-container').innerHTML = ''"
                    class="text-white/80 hover:text-white transition-colors cursor-pointer">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form method="post"
              action="@Url.Action("UpdateStock", "Flowers", new { area = "Admin" })"
              hx-post="@Url.Action("UpdateStock", "Flowers", new { area = "Admin" })"
              hx-target="#modal-container"
              hx-swap="innerHTML"
              hx-on::after-request="if(event.detail.successful) document.getElementById('modal-container').innerHTML = ''"
              class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.Name)
            @Html.HiddenFor(m => m.CurrentStock)
            @Html.HiddenFor(m => m.SelectedFlowersJson)

            <div class="flex items-center gap-3 p-3 bg-red-50 rounded-xl border border-red-100">
                <div class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center text-orange-600">
                    <i class="fa-solid fa-seedling"></i>
                </div>
                <div>
                    <h4 class="font-bold text-red-900">@Model.Name</h4>
                    <p class="text-xs text-gray-500">Trenutna zaliha: <span class="font-semibold text-gray-700">@Model.CurrentStock kom.</span></p>
                </div>
            </div>

            <div>
                @Html.LabelFor(m => m.Quantity, "Dodaj na zalihu", new { @class = "block text-sm font-semibold text-red-900 mb-1 font-secondary tracking-wide uppercase text-[10px]" })
                @Html.TextBoxFor(m => m.Quantity, new { @class = "w-full px-4 py-2 rounded-lg border border-red-200 focus:outline-none focus:ring-2 focus:ring-red-300 text-gray-700 bg-white/50", type = "number", min = "1" })
                @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-red-500 text-xs mt-1" })
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-red-100">
                <button type="button"
                        hx-post="@Url.Action("Delete", "Flowers", new { area = "Admin", id = Model.Id })"
                        hx-vals="js:{selectedFlowersJson: document.getElementById('SelectedFlowersJson').value}"
                        hx-target="#modal-container"
                        hx-swap="innerHTML"
                        hx-confirm="Da li ste sigurni da želite da obrišete cvet &quot;@Model.Name&quot;? Ova akcija se ne može poništiti."
                        hx-on::after-request="if(event.detail.successful) document.getElementById('modal-container').innerHTML = ''"
                        class="mr-auto px-4 py-2 text-xs font-semibold text-red-600 bg-white border border-red-300 rounded-lg hover:bg-red-50 transition-colors flex items-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-trash text-xs"></i>
                    <span>Obriši</span>
                </button>
                <button type="button"
                        onclick="document.getElementById('modal-container').innerHTML = ''"
                        class="px-4 py-2 text-xs font-semibold text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 transition-colors cursor-pointer">
                    Otkaži
                </button>
                <button type="submit"
                        class="px-4 py-2 text-xs font-semibold text-white bg-orange-500 hover:bg-orange-600 rounded-lg shadow-md transition-colors flex items-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-arrow-up text-xs"></i>
                    <span>Povećaj</span>
                </button>
            </div>
        </form>
    </div>
</div>
