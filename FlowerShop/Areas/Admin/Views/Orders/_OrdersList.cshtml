@using FlowerShop.Domain.Entities.Orders
@using FlowerShop.SharedKernel.Results
@using FlowerShop.Web.Helpers
@model PagedResult<FlowerShop.Application.Features.Orders.Queries.GetAdminOrders.AdminOrderDto>

<div class="overflow-x-auto w-full bg-red-100/30">
    <table class="w-full text-left">
        <thead class="bg-red-200/60 text-red-900 uppercase text-[10px] font-bold tracking-widest border-b border-red-200">
        <tr>
            <th class="p-4">Broj porudžbine</th>
            <th class="p-4">Kupac</th>
            <th class="p-4">Primalac & Adresa</th>
            <th class="p-4 hidden md:table-cell">Datum dostave</th>
            <th class="p-4 hidden lg:table-cell">Proizvodi</th>
            <th class="p-4 text-right">Iznos</th>
            <th class="p-4 text-center">Status</th>
            <th class="p-4 text-center hidden sm:table-cell">Dostava</th>
            <th class="p-4 text-center">Dostavljač</th>
            <th class="p-4 text-center">Detalji</th>
        </tr>
        </thead>
        <tbody class="text-gray-700 divide-y divide-red-200/80 text-sm">
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="10" class="p-16 text-center">
                    <div class="flex flex-col items-center justify-center gap-4">
                        <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center">
                            <i class="fa-solid fa-box-open text-4xl text-red-400"></i>
                        </div>
                        <div class="space-y-1">
                            <h3 class="text-xl font-bold text-red-900">Nema pronađenih porudžbina</h3>
                            <p class="text-sm text-gray-500">Trenutno nema porudžbina koje odgovaraju zadatim filterima.</p>
                        </div>
                    </div>
                </td>
            </tr>
        }
        @foreach (var order in Model.Items)
        {
            <tr class="hover:bg-red-50/70 transition-colors cursor-pointer group"
                hx-get="@Url.Action("Details", "Orders", new { area = "Admin", id = order.Id })"
                hx-target="#user-content"
                hx-swap="innerHTML"
                hx-push-url="true">
                
                <td class="p-4">
                    <div class="flex flex-col">
                        <span class="font-bold text-red-950 font-mono text-xs group-hover:text-red-700 transition-colors">@order.OrderNumber</span>
                        <span class="text-[11px] text-gray-500 mt-0.5">@order.CreatedAt.ToString("dd.MM.yyyy. HH:mm")</span>
                    </div>
                </td>

                <td class="p-4">
                    <div class="flex flex-col">
                        <span class="font-semibold text-red-950 text-xs">@(string.IsNullOrWhiteSpace(order.BuyerFullName) ? "Korisnik" : order.BuyerFullName)</span>
                        @if (!string.IsNullOrWhiteSpace(order.BuyerEmail))
                        {
                            <span class="text-[11px] text-gray-500">@order.BuyerEmail</span>
                        }
                    </div>
                </td>

                <td class="p-4">
                    <div class="flex flex-col">
                        <span class="font-semibold text-red-950">@order.RecipientFullName</span>
                        <span class="text-xs text-gray-600">@order.City, @order.OrderAddress</span>
                        <span class="text-[11px] text-gray-400">@order.RecipientPhoneNumber</span>
                    </div>
                </td>

                <td class="p-4 hidden md:table-cell whitespace-nowrap">
                    <div class="flex items-center gap-1.5 text-xs text-red-900 font-medium">
                        <i class="fa-regular fa-calendar-check text-red-700"></i>
                        <span>@order.OrderDate.ToString("dd.MM.yyyy. HH:mm")</span>
                    </div>
                </td>

                <td class="p-4 hidden lg:table-cell">
                    <div class="flex items-center gap-2">
                        <div class="flex -space-x-2 overflow-hidden">
                            @foreach (var item in order.Items.Take(3))
                            {
                                if (!string.IsNullOrWhiteSpace(item.ProductImagePath))
                                {
                                    <img src="@item.ProductImagePath" alt="@item.ProductName" title="@item.ProductName (@item.Quantity kom)" class="inline-block h-9 w-9 rounded-lg object-cover ring-2 ring-white border border-red-200" />
                                }
                                else
                                {
                                    <div class="inline-block h-9 w-9 rounded-lg bg-red-100 flex items-center justify-center ring-2 ring-white border border-red-200 text-red-600 text-xs font-bold" title="@item.ProductName (@item.Quantity kom)">
                                        <i class="fa-solid fa-seedling"></i>
                                    </div>
                                }
                            }
                        </div>
                        <span class="text-xs text-gray-600 font-medium">
                            @order.TotalItemsCount @(order.TotalItemsCount == 1 ? "artikal" : "artikla")
                        </span>
                    </div>
                </td>

                <td class="p-4 text-right font-bold text-red-950 whitespace-nowrap">
                    <span>@((order.OrderPrice + 300).ToString("N0")) RSD</span>
                </td>

                <td class="p-4 text-center whitespace-nowrap">
                    @switch (order.OrderStatus)
                    {
                        case OrderStatus.Pending:
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200">
                                <i class="fa-solid fa-hourglass-half text-[10px]"></i> Na čekanju
                            </span>
                            break;
                        case OrderStatus.Confirmed:
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                                <i class="fa-solid fa-check text-[10px]"></i> Potvrđeno
                            </span>
                            break;
                        case OrderStatus.Completed:
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                <i class="fa-solid fa-circle-check text-[10px]"></i> Završeno
                            </span>
                            break;
                        case OrderStatus.Cancelled:
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-300">
                                <i class="fa-solid fa-ban text-[10px]"></i> Otkazano
                            </span>
                            break;
                        default:
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-800">
                                @order.OrderStatus.GetDisplayName()
                            </span>
                            break;
                    }
                </td>

                <td class="p-4 text-center hidden sm:table-cell whitespace-nowrap">
                    @switch (order.DeliveryStatus)
                    {
                        case DeliveryStatus.Standby:
                            <span class="text-xs text-gray-600 bg-gray-100 px-2.5 py-1 rounded-full font-medium">U pripremi</span>
                            break;
                        case DeliveryStatus.Prepared:
                            <span class="text-xs text-orange-800 bg-orange-100 px-2.5 py-1 rounded-full font-medium">Spremno za slanje</span>
                            break;
                        case DeliveryStatus.InTransit:
                        case DeliveryStatus.OnTheWay:
                            <span class="text-xs text-blue-800 bg-blue-100 px-2.5 py-1 rounded-full font-medium flex items-center justify-center gap-1">
                                <i class="fa-solid fa-truck text-[10px]"></i> Na putu
                            </span>
                            break;
                        case DeliveryStatus.Delivered:
                            <span class="text-xs text-emerald-800 bg-emerald-100 px-2.5 py-1 rounded-full font-medium flex items-center justify-center gap-1">
                                <i class="fa-solid fa-house-chimney-check text-[10px]"></i> Uručeno
                            </span>
                            break;
                        default:
                            <span class="text-xs text-gray-600 bg-gray-100 px-2.5 py-1 rounded-full font-medium">@order.DeliveryStatus.GetDisplayName()</span>
                            break;
                    }
                </td>

                <td class="p-4 text-center whitespace-nowrap">
                    @if (!string.IsNullOrWhiteSpace(order.DelivererFullName))
                    {
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                            <i class="fa-solid fa-user-check text-[10px]"></i> @order.DelivererFullName
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 border border-rose-200">
                            <i class="fa-solid fa-user-xmark text-[10px]"></i> Nedodeljen
                        </span>
                    }
                </td>

                <td class="p-4 text-center" onclick="event.stopPropagation()">
                    <a hx-get="@Url.Action("Details", "Orders", new { area = "Admin", id = order.Id })"
                       hx-target="#user-content"
                       hx-swap="innerHTML"
                       hx-push-url="true"
                       title="Pregled detalja porudžbine"
                       class="px-3 py-1.5 rounded-lg bg-red-100 hover:bg-red-200 text-red-800 font-semibold text-xs transition-colors inline-flex items-center gap-1.5 cursor-pointer shadow-sm">
                        <i class="fa-solid fa-eye text-xs text-red-700"></i>
                        <span>Detalji</span>
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="px-5 py-4 bg-red-50/80 border-t border-red-200 flex flex-col sm:flex-row justify-between items-center gap-3 text-sm text-gray-600">
        <span>Stranica <span class="font-bold text-red-950">@Model.Page</span> od <span class="font-bold text-red-950">@Model.TotalPages</span> &mdash; ukupno <span class="font-bold text-red-950">@Model.TotalCount</span> porudžbina</span>
        <div class="flex gap-1">
            @if (Model.Page > 1)
            {
                <button type="button"
                        hx-get="@Url.Action("List", "Orders", new { area = "Admin", pageIndex = Model.Page - 1 })"
                        hx-target="#orders-table-container"
                        hx-include="[data-filter]"
                        class="px-3 py-1.5 rounded-lg bg-white border border-red-200 hover:bg-red-100 text-red-700 font-semibold transition-colors cursor-pointer">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                </button>
            }
            @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
            {
                if (i == Model.Page)
                {
                    <span class="px-3 py-1.5 rounded-lg gradient-red text-white font-bold text-xs">@i</span>
                }
                else
                {
                    <button type="button"
                            hx-get="@Url.Action("List", "Orders", new { area = "Admin", pageIndex = i })"
                            hx-target="#orders-table-container"
                            hx-include="[data-filter]"
                            class="px-3 py-1.5 rounded-lg bg-white border border-red-200 hover:bg-red-100 text-red-700 font-semibold text-xs transition-colors cursor-pointer">
                        @i
                    </button>
                }
            }
            @if (Model.Page < Model.TotalPages)
            {
                <button type="button"
                        hx-get="@Url.Action("List", "Orders", new { area = "Admin", pageIndex = Model.Page + 1 })"
                        hx-target="#orders-table-container"
                        hx-include="[data-filter]"
                        class="px-3 py-1.5 rounded-lg bg-white border border-red-200 hover:bg-red-100 text-red-700 font-semibold transition-colors cursor-pointer">
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </button>
            }
        </div>
    </div>
}
