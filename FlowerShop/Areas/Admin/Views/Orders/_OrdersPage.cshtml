@using FlowerShop.Domain.Entities.Orders
@using FlowerShop.Web.Helpers
@model FlowerShop.Web.Areas.Admin.Models.Orders.OrderSummaryViewModel

<div class="flex flex-col gap-6">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">

        <div class="flex flex-col gap-2 p-5 justify-center items-center bg-red-200/90 backdrop-blur-sm rounded-2xl shadow-lg font-semibold transition-all duration-200 hover:-translate-y-1 border-b-4 border-orange-500 group">
            <div class="p-3 bg-orange-100 rounded-full group-hover:scale-110 transition-transform duration-200">
                <i class="fa-solid fa-boxes-stacked text-2xl text-orange-600"></i>
            </div>
            <h4 class="text-3xl text-red-950 font-bold mt-1">@Model.TotalOrders</h4>
            <span class="text-center text-gray-600 uppercase text-xs tracking-wider">Ukupno</span>
        </div>

        <div class="flex flex-col gap-2 p-5 justify-center items-center bg-red-200/90 backdrop-blur-sm rounded-2xl shadow-lg font-semibold transition-all duration-200 hover:-translate-y-1 border-b-4 border-amber-500 group">
            <div class="p-3 bg-amber-100 rounded-full group-hover:scale-110 transition-transform duration-200">
                <i class="fa-solid fa-clock text-2xl text-amber-600"></i>
            </div>
            <h4 class="text-3xl text-red-950 font-bold mt-1">@Model.PendingOrders</h4>
            <span class="text-center text-gray-600 uppercase text-xs tracking-wider">Na čekanju</span>
        </div>

        <div class="flex flex-col gap-2 p-5 justify-center items-center bg-red-200/90 backdrop-blur-sm rounded-2xl shadow-lg font-semibold transition-all duration-200 hover:-translate-y-1 border-b-4 border-rose-500 group">
            <div class="p-3 bg-rose-100 rounded-full group-hover:scale-110 transition-transform duration-200">
                <i class="fa-solid fa-user-xmark text-2xl text-rose-600"></i>
            </div>
            <h4 class="text-3xl text-red-950 font-bold mt-1">@Model.UnassignedOrders</h4>
            <span class="text-center text-gray-600 uppercase text-xs tracking-wider">Nedodeljene</span>
        </div>

        <div class="flex flex-col gap-2 p-5 justify-center items-center bg-red-200/90 backdrop-blur-sm rounded-2xl shadow-lg font-semibold transition-all duration-200 hover:-translate-y-1 border-b-4 border-blue-500 group">
            <div class="p-3 bg-blue-100 rounded-full group-hover:scale-110 transition-transform duration-200">
                <i class="fa-solid fa-truck-fast text-2xl text-blue-600"></i>
            </div>
            <h4 class="text-3xl text-red-950 font-bold mt-1">@Model.InDeliveryOrders</h4>
            <span class="text-center text-gray-600 uppercase text-xs tracking-wider">U dostavi</span>
        </div>

        <div class="flex flex-col gap-2 p-5 justify-center items-center bg-red-200/90 backdrop-blur-sm rounded-2xl shadow-lg font-semibold transition-all duration-200 hover:-translate-y-1 border-b-4 border-emerald-500 group">
            <div class="p-3 bg-emerald-100 rounded-full group-hover:scale-110 transition-transform duration-200">
                <i class="fa-solid fa-circle-check text-2xl text-emerald-600"></i>
            </div>
            <h4 class="text-3xl text-red-950 font-bold mt-1">@Model.CompletedOrders</h4>
            <span class="text-center text-gray-600 uppercase text-xs tracking-wider">Završeno</span>
        </div>

    </div>

    <div class="flex flex-col shadow-xl bg-white/95 backdrop-blur-md rounded-2xl w-full overflow-hidden">

        <div class="gradient-red px-6 py-4 w-full flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <h4 class="text-white font-bold text-lg flex items-center gap-2.5">
                <i class="fa-solid fa-receipt text-orange-300"></i>
                Pregled porudžbina
            </h4>
            <span class="text-xs font-medium text-red-100 bg-red-900/40 px-3 py-1 rounded-full">
                Kliknite na porudžbinu za prikaz detalja i dodelu dostavljača
            </span>
        </div>

        <div class="p-4 bg-red-50/70 grid grid-cols-1 md:grid-cols-4 gap-3">
            <div class="relative w-full md:col-span-1">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
                <input type="text"
                       name="searchBy"
                       value="@Model.SearchBy"
                       placeholder="Pretraži po broju, kupcu, gradu..."
                       class="w-full pl-9 pr-4 py-2 text-sm rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-red-400 text-gray-700 placeholder-gray-400 border border-red-200"
                       hx-get="@Url.Action("List", "Orders", new { area = "Admin" })"
                       hx-target="#orders-table-container"
                       hx-trigger="keyup changed delay:400ms"
                       hx-include="[data-filter]"
                       hx-push-url="true" />
            </div>

            <div class="relative w-full">
                <select name="status"
                        data-filter
                        class="w-full text-sm rounded-lg bg-white px-3 py-2 pr-8 focus:outline-none focus:ring-2 focus:ring-red-400 text-gray-700 appearance-none cursor-pointer border border-red-200"
                        hx-get="@Url.Action("List", "Orders", new { area = "Admin" })"
                        hx-target="#orders-table-container"
                        hx-trigger="change"
                        hx-include="[data-filter]"
                        hx-push-url="true">
                    <option value="">Svi statusi porudžbine</option>
                    @foreach (OrderStatus statusVal in Enum.GetValues(typeof(OrderStatus)))
                    {
                        <option value="@statusVal" selected="@(Model.SelectedStatus == statusVal)">@statusVal.GetDisplayName()</option>
                    }
                </select>
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
            </div>

            <div class="relative w-full">
                <select name="deliveryStatus"
                        data-filter
                        class="w-full text-sm rounded-lg bg-white px-3 py-2 pr-8 focus:outline-none focus:ring-2 focus:ring-red-400 text-gray-700 appearance-none cursor-pointer border border-red-200"
                        hx-get="@Url.Action("List", "Orders", new { area = "Admin" })"
                        hx-target="#orders-table-container"
                        hx-trigger="change"
                        hx-include="[data-filter]"
                        hx-push-url="true">
                    <option value="">Svi statusi dostave</option>
                    @foreach (DeliveryStatus dStatusVal in Enum.GetValues(typeof(DeliveryStatus)))
                    {
                        <option value="@dStatusVal" selected="@(Model.SelectedDeliveryStatus == dStatusVal)">@dStatusVal.GetDisplayName()</option>
                    }
                </select>
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
            </div>

            <div class="relative w-full">
                <select name="sortBy"
                        data-filter
                        class="w-full text-sm rounded-lg bg-white px-3 py-2 pr-8 focus:outline-none focus:ring-2 focus:ring-red-400 text-gray-700 appearance-none cursor-pointer border border-red-200"
                        hx-get="@Url.Action("List", "Orders", new { area = "Admin" })"
                        hx-target="#orders-table-container"
                        hx-trigger="change"
                        hx-include="[data-filter]"
                        hx-push-url="true">
                    <option value="date_desc" selected="@(Model.SortBy == "date_desc")">Najnovije prvo</option>
                    <option value="date_asc" selected="@(Model.SortBy == "date_asc")">Najstarije prvo</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Iznos: veći ka manjem</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Iznos: manji ka većem</option>
                    <option value="delivery_asc" selected="@(Model.SortBy == "delivery_asc")">Datum dostave: bliži prvo</option>
                    <option value="delivery_desc" selected="@(Model.SortBy == "delivery_desc")">Datum dostave: dalji prvo</option>
                </select>
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
            </div>
        </div>

        <div id="orders-table-container" class="relative overflow-y-auto">
            <div id="filter-spinner" class="htmx-indicator absolute inset-0 bg-white/70 flex items-center justify-center z-10 rounded-b-xl">
                <div class="flex items-center gap-3 text-red-700 font-semibold">
                    <i class="fa-solid fa-spinner fa-spin text-2xl"></i>
                    <span class="text-sm">Učitavanje porudžbina...</span>
                </div>
            </div>
            @await Html.PartialAsync("_OrdersList", Model.PagedOrders)
        </div>

    </div>

    <div id="modal-container"></div>
</div>
