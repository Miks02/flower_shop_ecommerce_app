@using FlowerShop.Domain.Entities.Deliverers
@using FlowerShop.Domain.Enums
@using FlowerShop.Web.Helpers
@model FlowerShop.Web.Areas.Deliverer.Models.DelivererDashboardViewModel

<div class="flex flex-col md:flex-row mx-2 sm:mx-5 py-3 sm:py-5 gap-5">
    <div class="flex flex-col w-full gap-5">
        <div class="flex flex-col shadow-xl bg-red-100 rounded-xl transition-all duration-200 hover:-translate-y-1">
            <div class="text-red-100 gradient-red top-0 px-4 py-2 left-0 rounded-t-xl w-full flex items-center justify-between">
                <h4 class="text-red-100 font-bold flex items-center gap-2">
                    <i class="fa-solid fa-id-card"></i>
                    Informacije o dostavljaču
                </h4>
            </div>
            <div class="flex flex-wrap p-3 sm:p-4 gap-4">
                <div class="flex flex-wrap w-full gap-4">
                    <div class="flex flex-col gap-1 p-3 w-auto flex-1 min-w-[200px] bg-red-200 shadow-xl rounded-lg">
                        <div class="text-gray-500 text-sm">
                            <i class="fa-solid fa-user mr-2 text-orange-600"></i>
                            <span>Ime</span>
                        </div>
                        <h5 class="text-red-900 font-bold text-base">@Model.FirstName</h5>
                    </div>
                    <div class="flex flex-col gap-1 p-3 w-auto flex-1 min-w-[200px] bg-red-200 shadow-xl rounded-lg">
                        <div class="text-gray-500 text-sm">
                            <i class="fa-solid fa-user mr-2 text-orange-600"></i>
                            <span>Prezime</span>
                        </div>
                        <h5 class="text-red-900 font-bold text-base">@Model.LastName</h5>
                    </div>
                </div>

                <div class="flex flex-wrap w-full gap-4">
                    <div class="flex flex-col gap-1 p-3 w-auto flex-1 min-w-[200px] bg-red-200 shadow-xl rounded-lg">
                        <div class="text-gray-500 text-sm">
                            <i class="fa-solid fa-at mr-2 text-orange-600"></i>
                            <span>Email adresa</span>
                        </div>
                        <h5 class="text-red-900 font-bold text-base break-all">@Model.Email</h5>
                    </div>
                    <div class="flex flex-col gap-1 p-3 w-auto flex-1 min-w-[200px] bg-red-200 shadow-xl rounded-lg">
                        <div class="text-gray-500 text-sm">
                            <i class="fa-solid fa-phone mr-2 text-orange-600"></i>
                            <span>Telefon</span>
                        </div>
                        <h5 class="text-red-900 font-bold text-base">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "/" : Model.PhoneNumber)</h5>
                    </div>
                </div>

                <div class="flex flex-wrap w-full gap-4">
                    <div class="flex flex-col gap-1 p-3 w-auto flex-1 min-w-[200px] bg-red-200 shadow-xl rounded-lg">
                        <div class="text-gray-500 text-sm">
                            <i class="fa-solid fa-truck mr-2 text-orange-600"></i>
                            <span>Tip vozila</span>
                        </div>
                        <div class="flex items-center gap-2 mt-1">
                            @switch (Model.VehicleType)
                            {
                                case VehicleType.Bicycle:
                                    <i class="fa-solid fa-bicycle text-orange-600 text-lg"></i>
                                    <span class="text-red-950 font-bold text-base">Bicikl (min. 1 proizvod)</span>
                                    break;
                                case VehicleType.Scooter:
                                    <i class="fa-solid fa-motorcycle text-orange-600 text-lg"></i>
                                    <span class="text-red-950 font-bold text-base">Skuter (min. 3 proizvoda)</span>
                                    break;
                                case VehicleType.Car:
                                    <i class="fa-solid fa-car text-orange-600 text-lg"></i>
                                    <span class="text-red-950 font-bold text-base">Automobil (min. 5 proizvoda)</span>
                                    break;
                            }
                        </div>
                    </div>
                    <div class="flex flex-col gap-1 p-3 w-auto flex-1 min-w-[200px] bg-red-200 shadow-xl rounded-lg">
                        <div class="text-gray-500 text-sm">
                            <i class="fa-solid fa-circle-dot mr-2 text-orange-600"></i>
                            <span>Status dostavljača</span>
                        </div>
                        <div class="flex items-center gap-2 mt-1">
                            @switch (Model.DelivererStatus)
                            {
                                case DelivererStatus.Available:
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Dostupan
                                    </span>
                                    break;
                                case DelivererStatus.OnDuty:
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-amber-500"></span> Na dostavi
                                    </span>
                                    break;
                                case DelivererStatus.Unavailable:
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800 flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-rose-500"></span> Nedostupan
                                    </span>
                                    break;
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap w-full p-2 gap-4">
            <div class="flex flex-col flex-1 min-w-[140px] gap-2 p-5 justify-center items-center bg-red-200 rounded-xl shadow-xl font-semibold transition-all duration-200 hover:-translate-y-1">
                <div class="p-3 bg-amber-100 rounded-full">
                    <i class="fa-solid fa-star text-3xl text-amber-500"></i>
                </div>
                <h4 class="text-3xl text-red-950 font-bold mt-1">@Model.AverageRating.ToString("0.0")</h4>
                <span class="text-center text-gray-600 uppercase text-xs tracking-wider">Prosečna ocena</span>
                <div class="flex gap-1 text-amber-400 text-xs mt-1">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                </div>
            </div>

            <div class="flex flex-col flex-1 min-w-[140px] gap-2 p-5 justify-center items-center bg-red-200 rounded-xl shadow-xl font-semibold transition-all duration-200 hover:-translate-y-1">
                <div class="p-3 bg-orange-100 rounded-full">
                    <i class="fa-solid fa-truck-fast text-3xl text-orange-600"></i>
                </div>
                <h4 class="text-3xl text-red-950 font-bold mt-1">@Model.TotalDeliveries</h4>
                <span class="text-center text-gray-600 uppercase text-xs tracking-wider">Broj dostava</span>
            </div>

            <div class="flex flex-col flex-1 min-w-[140px] gap-2 p-5 justify-center items-center bg-red-200 rounded-xl shadow-xl font-semibold transition-all duration-200 hover:-translate-y-1">
                <div class="p-3 bg-emerald-100 rounded-full">
                    <i class="fa-solid fa-clipboard-check text-3xl text-emerald-600"></i>
                </div>
                <h4 class="text-3xl text-red-950 font-bold mt-1">@Model.CompletedDeliveries</h4>
                <span class="text-center text-gray-600 uppercase text-xs tracking-wider">Završene dostave</span>
            </div>
        </div>
    </div>

    <div class="flex flex-col w-full lg:w-[45%] xl:w-[40%] gap-5">
        <div class="flex flex-col gap-4 p-5 shadow-xl bg-red-100 rounded-xl transition-all duration-200 hover:-translate-y-1">
            <div class="flex flex-col gap-2 justify-center items-center">
                <div class="mx-auto shadow-xl w-32 h-32 font-bold bg-orange-400 text-red-100 rounded-full flex items-center justify-center text-3xl">
                    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <img class="h-32 w-32 rounded-full object-cover" src="@Model.ProfilePicture" alt="@Model.FullName" />
                    }
                    else
                    {
                        @(Model.FirstName.Length > 0 && Model.LastName.Length > 0 ? $"{Model.FirstName[0]}{Model.LastName[0]}" : "D")
                    }
                </div>
            </div>
            <div class="text-center">
                <h4 class="text-red-950 text-xl font-bold">@Model.FullName</h4>
                <span class="inline-block px-3 py-1 mt-1 rounded-full text-xs font-semibold bg-orange-200 text-orange-950">Dostavljač</span>
            </div>

            <div class="flex flex-col gap-3 mt-2">
                <a hx-get="/Deliverer/Orders"
                   hx-target="#user-content"
                   hx-swap="innerHTML"
                   hx-push-url="true"
                   class="btn-classic gradient-red text-white flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-box"></i>
                    <span>Pregled narudžbina</span>
                </a>
                <a hx-get="/Deliverer/Settings"
                   hx-target="#user-content"
                   hx-swap="innerHTML"
                   hx-push-url="true"
                   class="btn-classic hover:bg-gray-200 text-gray-700 flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-gear"></i>
                    <span>Podešavanja</span>
                </a>
            </div>
        </div>

        <div class="flex flex-col shadow-xl bg-red-100 rounded-xl transition-all duration-200 hover:-translate-y-1">
            <div class="text-red-100 gradient-red top-0 px-4 py-2 left-0 rounded-t-xl w-full">
                <h4 class="text-red-100 font-bold flex items-center gap-2">
                    <i class="fa-solid fa-info-circle"></i>
                    Status naloga & angažovanja
                </h4>
            </div>
            <div class="p-3 font-semibold divide-y divide-red-200/60">
                <div class="flex w-full justify-between p-2 items-center">
                    <span class="text-gray-600 text-sm">Status naloga:</span>
                    @if (Model.AccountStatus == AccountStatus.Active)
                    {
                        <div class="badge new p-2">Aktivan</div>
                    }
                    else
                    {
                        <div class="badge out-of-stock p-2">Neaktivan</div>
                    }
                </div>
                <div class="flex w-full justify-between p-2 items-center">
                    <span class="text-gray-600 text-sm">Datum registracije:</span>
                    <span class="text-red-950 font-bold">@Model.RegistrationDate</span>
                </div>
                <div class="flex w-full justify-between p-2 items-center">
                    <span class="text-gray-600 text-sm">Tip vozila:</span>
                    <span class="text-red-950 font-bold">@Model.VehicleType.GetDisplayName()</span>
                </div>
                <div class="flex w-full justify-between p-2 items-center">
                    <span class="text-gray-600 text-sm">Aktivne dostave:</span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-orange-100 text-orange-800">@Model.ActiveDeliveries</span>
                </div>
            </div>
        </div>
    </div>
</div>
