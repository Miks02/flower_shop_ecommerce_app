@model FlowerShop.Web.ViewModels.CatalogueViewModel
@{
    ViewData["Title"] = "Asortiman";
    Layout = "_Layout";
}

@await Component.InvokeAsync("Hero", new
{
    title = "Asortiman",
    subtitle = "Pregled asortimana"
})

<section class="w-screen min-h-[400px] bg-gradient-to-tr from-red-100 to-rose-100">
    <div class="flex md:justify-center p-4 md:p-12 gap-6">
        <aside class="hidden md:flex flex-col sticky top-[10%] overflow-y-auto max-h-[850px] bg-red-200 min-w-[300px] rounded-2xl shadow-lg">
            <div class="flex mt-4 px-6 flex-col">
                <h3 class="text-red-800 text-xl font-semibold"><i class="fa-solid fa-filter"></i> Filteri</h3>
                <div class="bg-red-800 h-px w-full mx-auto mt-4"></div>
            </div>

            <form id="catalog-filters"
                  class="flex flex-col px-6 pb-6"
                  hx-get="@Url.Action("List", "Catalogue")"
                  hx-target="#catalog-results"
                  hx-include="#catalog-filters"
                  hx-indicator="#catalog-loading"
                  hx-trigger="change delay:250ms, input delay:250ms from:#price-range"
                  hx-push-url="true">
                <input type="hidden" id="catalog-page" name="Page" value="@Model.Page" />
                <input type="hidden" name="PageSize" value="@Model.PageSize" />

                <div class="mt-4">
                    <h4 class="text-red-800 text-lg font-semibold"><i class="fa-regular fa-bookmark mr-2"></i> Kategorije</h4>
                    <div class="flex flex-col gap-4 m-4">
                        @foreach (var category in Model.Categories)
                        {
                            <div>
                                <input type="checkbox"
                                       id="category-@category.Id"
                                       name="CategoryIds"
                                       value="@category.Id"
                                       class="primary-checkbox data-reset-page"
                                       checked="@(Model.CategoryIds.Contains(category.Id) ? "checked" : null)" />
                                <label for="category-@category.Id" class="checkbox-label-primary">@category.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <h4 class="text-red-800 text-lg font-semibold"><i class="bi bi-tag mr-2 text-lg"></i> Prilike</h4>
                    <div class="flex flex-col gap-4 m-4">
                        @foreach (var occasion in Model.Occasions)
                        {
                            <div>
                                <input type="checkbox"
                                       id="occasion-@occasion.Id"
                                       name="OccasionIds"
                                       value="@occasion.Id"
                                       class="primary-checkbox data-reset-page"
                                       checked="@(Model.OccasionIds.Contains(occasion.Id) ? "checked" : null)" />
                                <label for="occasion-@occasion.Id" class="checkbox-label-primary">@occasion.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <h4 class="text-red-800 text-lg font-semibold"><i class="bi bi-wallet2 mr-2"></i> Cenovni opseg</h4>
                    <div class="flex flex-col gap-4 m-4">
                        <input type="range"
                               min="0"
                               max="50000"
                               step="100"
                               id="price-range"
                               name="PriceRange"
                               value="@Model.PriceRange"
                               class="w-full bg-gray-200 active:bg-red-400 shadow-md transition-all data-reset-page" />
                        <label for="price-range" class="block text-center mt-2 text-red-800 font-semibold">
                            Cena: <span id="price-tag" class="text-yellow-700">@Model.PriceRange</span> RSD
                        </label>
                    </div>
                </div>
            </form>
        </aside>

        <div class="flex flex-col md:mx-5 gap-6 md:w-[70%] mx-auto w-full">
            <div class="bg-red-300 w-full p-3 rounded-2xl shadow-md">
                <div class="flex justify-between items-center gap-3">
                    <p class="text-red-900 font-semibold">Prikazano @Model.PagedProducts.PaginatedCount od @Model.PagedProducts.TotalCount proizvoda</p>
                    <div class="relative w-full max-w-[220px]">
                        <select id="catalog-sort"
                                name="Sort"
                                form="catalog-filters"
                                class="custom-select data-reset-page w-full"
                                hx-get="@Url.Action("List", "Catalogue")"
                                hx-target="#catalog-results"
                                hx-include="#catalog-filters"
                                hx-indicator="#catalog-loading"
                                hx-trigger="change delay:250ms"
                                hx-push-url="true">
                            <option value="name_asc" selected="@(Model.Sort == "name_asc" ? "selected" : null)">Naziv A-Z</option>
                            <option value="name_desc" selected="@(Model.Sort == "name_desc" ? "selected" : null)">Naziv Z-A</option>
                            <option value="price_asc" selected="@(Model.Sort == "price_asc" ? "selected" : null)">Cena rastuće</option>
                            <option value="price_desc" selected="@(Model.Sort == "price_desc" ? "selected" : null)">Cena opadajuće</option>
                        </select>
                    </div>
                </div>
            </div>

            <div id="catalog-results-wrapper" class="relative min-h-[180px]">
                <div id="catalog-loading" class="hidden absolute inset-0 bg-white/70 items-center justify-center z-10 rounded-2xl">
                    <div class="flex items-center gap-3 text-red-700">
                        <i class="fa-solid fa-spinner fa-spin text-2xl"></i>
                        <span class="text-sm font-medium">Učitavanje...</span>
                    </div>
                </div>
                <div id="catalog-results">
                    @await Html.PartialAsync("Partial/_ProductList", Model.PagedProducts)
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function setCatalogPage(page) {
        const pageInput = document.getElementById("catalog-page");
        if (pageInput) {
            pageInput.value = page;
        }
    }

    (function () {
        const loading = document.getElementById("catalog-loading");
        const pageInput = document.getElementById("catalog-page");
        document.querySelectorAll(".data-reset-page").forEach((element) => {
            element.addEventListener("change", () => {
                if (pageInput) {
                    pageInput.value = "1";
                }
            });
            element.addEventListener("input", () => {
                if (pageInput) {
                    pageInput.value = "1";
                }
            });
        });

        const priceRange = document.getElementById("price-range");
        const priceTag = document.getElementById("price-tag");
        if (priceRange && priceTag) {
            priceRange.addEventListener("input", () => {
                priceTag.textContent = priceRange.value;
            });
        }

        document.body.addEventListener("htmx:beforeRequest", (event) => {
            const path = event.detail?.requestConfig?.path || "";
            if (!path.includes("/Catalogue/List")) {
                return;
            }

            if (loading) {
                loading.classList.remove("hidden");
                loading.classList.add("flex");
            }
        });

        document.body.addEventListener("htmx:afterRequest", (event) => {
            const path = event.detail?.requestConfig?.path || "";
            if (!path.includes("/Catalogue/List")) {
                return;
            }

            if (loading) {
                setTimeout(() => {
                    loading.classList.remove("flex");
                    loading.classList.add("hidden");
                }, 120);
            }
        });
    })();
</script>
