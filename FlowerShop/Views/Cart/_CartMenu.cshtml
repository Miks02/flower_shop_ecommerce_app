@model FlowerShop.Application.Features.Cart.Queries.GetCart.GetCartResponse

<div class="flex flex-col p-4 h-full">

    <div class="flex justify-between items-center content-center border-b border-b-red-100 mb-1 pb-3">
        <h4 class="text-xl font-semibold">Vaša korpa <span class="text-red-400 text-base">(@Model.ItemCount)</span></h4>
        <button type="button" data-menu="cart-close" class="text-3xl pb-1 hover:text-red-200 duration-200">
            <i class="fa-solid fa-close"></i>
        </button>
    </div>

    <div class="flex flex-col justify-between h-full">
        @if (Model.Items.Count == 0)
        {
            <p class="text-center mt-10 text-red-200 font-semibold">Korpa je prazna</p>
        }
        else
        {
            <ul class="flex flex-col w-full gap-3 mt-4 overflow-y-auto">
                @foreach (var item in Model.Items)
                {
                    <li class="group flex items-center gap-3 py-2 px-1 rounded-lg transition-all duration-300 hover:bg-red-500/10">
                        <img src="@item.ImageUrl" alt="@item.ProductName" class="w-16 h-16 rounded-lg object-cover flex-shrink-0" />
                        <div class="flex-1 min-w-0">
                            <p class="font-medium truncate">@item.ProductName</p>
                            <p class="text-sm text-amber-200">@item.Price RSD × <span class="font-semibold">@item.Quantity</span></p>
                        </div>
                        <form hx-post="@Url.Action("Remove", "Cart", new { id = item.Id })"
                              hx-target="#cart-menu"
                              hx-swap="innerHTML">
                            <button type="submit" class="text-gray-300 hover:text-red-400 transition-colors duration-200 px-2">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </li>
                }
            </ul>

            <div class="mt-auto border-t border-t-red-100 pt-3">
                <div class="flex justify-between items-center mb-3 px-1">
                    <span class="text-gray-100">Ukupno</span>
                    <span class="text-xl font-semibold text-amber-500">@Model.Total RSD</span>
                </div>
                <a asp-controller="Checkout" asp-action="Index"
                   class="group flex w-full justify-center items-center py-2.5 px-3 rounded-lg bg-red-800 text-white transition-all duration-300 hover:bg-red-700">
                    <i class="fa-solid fa-lock mr-3"></i>
                    <span>Nastavi na plaćanje</span>
                </a>
            </div>
        }
    </div>

</div>
