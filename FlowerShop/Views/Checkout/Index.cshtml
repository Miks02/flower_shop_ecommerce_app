@{
    ViewBag.Title = "Plaćanje";
}

@await Component.InvokeAsync("Hero", new
{
    title = "Plaćanje",
    subtitle = "Unesite podatke za dostavu i završite porudžbinu.",
})

<section class="w-full min-h-screen bg-gradient-to-br from-rose-50 via-red-50 to-pink-100 py-10 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-8 items-start">

        <div class="w-full lg:w-2/3 flex flex-col gap-6">

            <div class="bg-red-200/90 backdrop-blur-md p-6 sm:p-8 rounded-3xl shadow-xl text-red-950 flex flex-col gap-5">
                <div class="flex items-center gap-3 border-b border-red-300/60 pb-4">
                    <span class="w-8 h-8 rounded-full bg-red-700 text-white flex items-center justify-center font-bold text-sm shadow">1</span>
                    <h2 class="text-2xl font-bold text-red-900">Podaci za dostavu</h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label for="fullname" class="text-sm font-semibold text-red-800">Ime i prezime primaoca</label>
                        <input type="text" id="fullname" name="fullname" placeholder="Petar Petrović" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label for="phone" class="text-sm font-semibold text-red-800">Telefon primaoca</label>
                        <input type="tel" id="phone" name="phone" placeholder="06X XXX XXXX" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                    </div>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="address" class="text-sm font-semibold text-red-800">Adresa dostave</label>
                    <input type="text" id="address" name="address" placeholder="Ulica i broj, sprat, stan..." class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label for="city" class="text-sm font-semibold text-red-800">Grad</label>
                        <input type="text" id="city" name="city" placeholder="Beograd" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label for="postalCode" class="text-sm font-semibold text-red-800">Poštanski broj</label>
                        <input type="text" id="postalCode" name="postalCode" placeholder="11000" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label for="deliveryDate" class="text-sm font-semibold text-red-800">Datum dostave</label>
                        <input type="date" id="deliveryDate" name="deliveryDate" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label for="deliveryTime" class="text-sm font-semibold text-red-800">Željeno vreme</label>
                        <input type="time" id="deliveryTime" name="deliveryTime" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                    </div>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="cardMessage" class="text-sm font-semibold text-red-800">Poruka na čestitki (opciono)</label>
                    <textarea rows="3" id="cardMessage" name="cardMessage" placeholder="Npr. Srećan rođendan!" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950 resize-none"></textarea>
                </div>
            </div>

            <div class="bg-red-300/80 backdrop-blur-md p-6 sm:p-8 rounded-3xl shadow-xl text-red-950 flex flex-col gap-5">
                <div class="flex items-center gap-3 border-b border-red-400/50 pb-4">
                    <span class="w-8 h-8 rounded-full bg-red-800 text-white flex items-center justify-center font-bold text-sm shadow">2</span>
                    <h2 class="text-2xl font-bold text-red-950">Kontakt podaci kupca</h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label for="buyerEmail" class="text-sm font-semibold text-red-900">Email adresa</label>
                        <input type="email" id="buyerEmail" value="@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value" name="buyerEmail" placeholder="vas@email.com" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label for="buyerPhone" class="text-sm font-semibold text-red-900">Vaš kontakt telefon</label>
                        <input type="tel" id="buyerPhone" name="buyerPhone" value="@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.OtherPhone)?.Value" placeholder="06X XXX XXXX" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                    </div>
                </div>
            </div>

            <div class="bg-red-200/90 backdrop-blur-md p-6 sm:p-8 rounded-3xl shadow-xl text-red-950 flex flex-col gap-5">
                <div class="flex items-center justify-between border-b border-red-300/60 pb-4">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-full bg-red-700 text-white flex items-center justify-center font-bold text-sm shadow">3</span>
                        <h2 class="text-2xl font-bold text-red-900">Plaćanje karticom</h2>
                    </div>
                    <div class="flex gap-2 text-2xl text-red-800">
                        <i class="fa-brands fa-cc-visa"></i>
                        <i class="fa-brands fa-cc-mastercard"></i>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label for="cardNumber" class="text-sm font-semibold text-red-800">Broj kartice</label>
                        <div class="relative">
                            <input type="text" id="cardNumber" name="cardNumber" placeholder="4123 4567 8901 2345" maxlength="19" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950 pl-11">
                            <i class="fa-solid fa-credit-card absolute left-4 top-1/2 -translate-y-1/2 text-red-700"></i>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label for="cardExpiry" class="text-sm font-semibold text-red-800">Ističe (MM/YY)</label>
                            <input type="text" id="cardExpiry" name="cardExpiry" placeholder="08/28" maxlength="5" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label for="cardCvc" class="text-sm font-semibold text-red-800">CVC / CWW</label>
                            <input type="password" id="cardCvc" name="cardCvc" placeholder="123" maxlength="4" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                        </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label for="cardHolder" class="text-sm font-semibold text-red-800">Ime na kartici</label>
                        <input type="text" id="cardHolder" name="cardHolder" placeholder="PETAR PETROVIC" class="w-full p-2 border-2 shadow-2xl transition-all bg-red-200 placeholder-gray-500 border-red-500 rounded-md focus:outline-none focus:ring-4 focus:ring-red-400 focus:border-red-200 text-red-950">
                    </div>
                </div>

                <div class="pt-4 flex flex-col gap-4 border-t border-red-300/60">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="terms" name="terms" class="w-5 h-5 accent-red-700 rounded">
                        <span class="text-sm font-medium text-red-900">Slažem se sa uslovima korišćenja i politikom privatnosti</span>
                    </label>

                    <button type="submit" class="w-full py-4 bg-red-800 hover:bg-red-900 text-white font-bold text-lg rounded-xl shadow-lg shadow-red-900/20 hover:scale-[1.01] transition-all duration-200 flex items-center justify-center gap-3">
                        <i class="fa-solid fa-lock"></i>
                        Potvrdi i plati (13,300 RSD)
                    </button>
                </div>
            </div>

        </div>

        <div class="w-full lg:w-1/3 lg:sticky lg:top-6 flex flex-col gap-6">

            <div class="bg-red-300/80 backdrop-blur-md p-6 rounded-3xl shadow-xl text-red-950 flex flex-col gap-5">
                <h2 class="text-2xl font-bold border-b border-red-400/50 pb-4 text-red-950">Pregled porudžbine</h2>

                <div class="flex flex-col gap-4 max-h-[320px] overflow-y-auto pr-1">
                    <div class="flex gap-3 items-center">
                        <img src="https://placehold.co/64x64/fecaca/991b1b?text=Ruze" class="w-14 h-14 rounded-xl object-cover shrink-0">
                        <div class="flex-1 min-w-0">
                            <p class="font-semibold text-sm truncate text-red-950">Buket crvenih ruža</p>
                            <p class="text-xs text-red-800 font-medium">2,500 RSD × 2</p>
                        </div>
                        <p class="font-bold text-sm text-red-950">5,000 RSD</p>
                    </div>

                    <div class="flex gap-3 items-center">
                        <img src="https://placehold.co/64x64/fed7aa/9a3412?text=Tulipani" class="w-14 h-14 rounded-xl object-cover shrink-0">
                        <div class="flex-1 min-w-0">
                            <p class="font-semibold text-sm truncate text-red-950">Aranžman od tulipana</p>
                            <p class="text-xs text-red-800 font-medium">3,200 RSD × 1</p>
                        </div>
                        <p class="font-bold text-sm text-red-950">3,200 RSD</p>
                    </div>

                    <div class="flex gap-3 items-center">
                        <img src="https://placehold.co/64x64/ddd6fe/5b21b6?text=Orhideja" class="w-14 h-14 rounded-xl object-cover shrink-0">
                        <div class="flex-1 min-w-0">
                            <p class="font-semibold text-sm truncate text-red-950">Bela orhideja u saksiji</p>
                            <p class="text-xs text-red-800 font-medium">4,800 RSD × 1</p>
                        </div>
                        <p class="font-bold text-sm text-red-950">4,800 RSD</p>
                    </div>
                </div>

                <div class="bg-red-200/80 p-4 rounded-2xl flex flex-col gap-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-red-900 flex items-center gap-1.5">
                            <i class="fa-solid fa-crown text-amber-600"></i> Loyalty program
                        </span>
                        <span class="text-xs bg-red-400/40 text-red-950 px-2 py-0.5 rounded-full font-bold">450 poena</span>
                    </div>
                    <p class="text-xs text-red-800">Imate 450 poena (1 poen = 1 RSD popusta)</p>
                    <label class="flex items-center gap-2 mt-1 cursor-pointer">
                        <input type="checkbox" name="useLoyalty" class="w-4 h-4 accent-red-700 rounded">
                        <span class="text-xs font-semibold text-red-950">Iskoristi 450 poena (-450 RSD)</span>
                    </label>
                </div>
                
                <div class="border-t border-red-400/50 pt-4 flex flex-col gap-2 text-sm">
                    <div class="flex justify-between text-red-900">
                        <span>Međuzbir</span>
                        <span class="font-semibold text-red-950">13,000 RSD</span>
                    </div>
                    <div class="flex justify-between text-red-900">
                        <span>Dostava</span>
                        <span class="font-semibold text-red-950">300 RSD</span>
                    </div>
                    
                    <div class="flex justify-between text-lg font-bold text-red-950 pt-3 border-t border-red-400/50">
                        <span>Ukupno za uplatu</span>
                        <span class="text-red-900">13,300 RSD</span>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>