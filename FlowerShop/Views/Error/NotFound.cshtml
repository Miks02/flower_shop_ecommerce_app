@{
    ViewData["Title"] = "Stranica nije pronađena";
    Layout = "_ErrorLayout";
}

<img src="~/AppImages/Logo bez pozadine.png" alt="Cvećara Nikolić" class="mb-6 bg-red-400 rounded-xl p-4 shadow-xl"/>

<h2 class="text-5xl mb-2 mt-2 font-semibold text-red-900">GREŠKA 404</h2>

<h1 class="text-3xl sm:text-4xl font-semibold text-red-900">Stranica nije pronađena</h1>

<p class="text-lg text-gray-700 mt-4">
    @if (!string.IsNullOrEmpty(ViewData["NotFoundMessage"] as string))
    {
        <p class="font-semibold text-red-900 text-xl">@ViewData["NotFoundMessage"]</p>
    }
    else
    {
        <p class="font-semibold text-red-900 text-xl">Tražena stranica ili resurs nije pronađen.</p>
    }
</p>
<p class="text-base text-gray-600 mt-2">
    Možda je stranica premeštena, obrisana ili nikada nije postojala. Proverite da li ste uneli ispravan URL.
</p>

<a asp-area="" asp-controller="Home" asp-action="Index"
   class="mt-8 inline-flex items-center gap-2 bg-red-900 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-800 transition-all duration-200">
    <i class="fa-solid fa-house"></i>
    Početna
</a>
