@{
    ViewData["Title"] = "Greška";
    Layout = "_ErrorLayout";
}

<img src="~/AppImages/Logo bez pozadine.png" alt="Cvećara Nikolić" class="mb-6 bg-red-400 rounded-xl p-4 shadow-xl"/>

<i class="fa-solid fa-triangle-exclamation text-5xl text-red-700 mb-4"></i>

<h1 class="text-3xl sm:text-4xl font-semibold text-red-900">Došlo je do neočekivane greške</h1>

<p class="text-lg text-gray-700 mt-4">
    Došlo je do neočekivane greške, pokušajte ponovo kasnije.
</p>
<p class="text-base text-gray-600 mt-2">
    Naš tim je automatski obavešten o problemu i radi na njegovom otklanjanju. Ukoliko se greška
    ponovi i dalje, slobodno nas kontaktirajte putem stranice za kontakt.
</p>

<a asp-area="" asp-controller="Home" asp-action="Index"
   class="mt-8 inline-flex items-center gap-2 bg-red-900 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-800 transition-all duration-200">
    <i class="fa-solid fa-house"></i>
    Početna
</a>
