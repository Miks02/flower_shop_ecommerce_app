@using FlowerShop.Domain.Entities.Orders
@using FlowerShop.Domain.Enums
@using FlowerShop.Web.ViewModels.Components
@model UserProfileViewModel

<div class="flex flex-col md:flex-row mx-2 sm:mx-5 py-3 sm:py-5 gap-5">
        
    <div class="flex flex-col w-full gap-5">
        <div class="flex flex-col shadow-xl bg-red-100 rounded-xl transition-all duration-200 hover:-translate-y-1">
            <div class=" text-red-100 gradient-red top-0 px-4 py-2 left-0 rounded-t-xl w-full">
                <h4 class="text-red-100">
                    <i class="fa-solid fa-user mr-2"></i>
                    Lične informacije
                </h4>
            </div>
            <div class="flex flex-wrap p-2 gap-4 ">
                <div class="flex flex-wrap w-full gap-5">
                    <div class="flex flex-col gap-1  p-3 w-auto flex-1 bg-red-200 shadow-xl">
                        <div class="text-gray-500">
                            <i class="fa-solid fa-user mr-2"></i>
                            <span>Ime</span>
                        </div>
                        <h5 class="text-red-900 font-semibold">@Model.FirstName</h5>
                    </div>
                    <div class="flex flex-col gap-1 p-3 w-auto bg-red-200 flex-1 shadow-xl w-25">
                        <div class="text-gray-500">
                            <i class="fa-solid fa-user mr-2"></i>
                            <span>Prezime</span>
                        </div>
                        <h5 class="text-red-900 font-semibold">@Model.LastName</h5>
                    </div>
                </div>
                <div class="flex flex-wrap  w-full gap-5">
                    <div class="flex flex-col gap-1 p-3 w-auto flex-1 bg-red-200 shadow-xl">
                        <div class="text-gray-500">
                            <i class="fa-solid fa-at mr-2"></i>
                            <span>Email adresa</span>
                        </div>
                        <h5 class="text-red-900 font-semibold break-all">@Model.Email</h5>
                    </div>
                    <div class="flex flex-col gap-1 p-3 w-auto bg-red-200 flex-1 shadow-xl w-25">
                        <div class="text-gray-500">
                            <i class="fa-solid fa-phone mr-2"></i>
                            <span>Telefon</span>
                        </div>
                        <h5 class="text-red-900 font-semibold">@Model.PhoneNumber</h5>
                    </div>
                </div>
                    

            </div>
        </div>
            
        <div class="flex flex-wrap w-full p-4 gap-5 ">
                
            <div class="flex flex-col flex-1 gap-3 p-4 justify-center items-center bg-red-200 rounded-xl shadow-xl font-semibold transition-all duration-200 hover:-translate-y-1">
                <i class="fa-solid fa-box text-4xl text-orange-600"></i>
                <h4 class="text-2xl text-red-700">@Model.TotalOrders</h4>
                <span class="text-center text-gray-600">Broj porudžbina</span>
            </div>
            <div class="flex flex-col flex-1 gap-3 p-4 justify-center items-center bg-red-200 rounded-xl shadow-xl font-semibold transition-all duration-200 hover:-translate-y-1">
                <i class="fa-solid fa-gift text-4xl text-orange-600"></i>
                <h4 class="text-2xl text-red-700">@Model.LoyaltyPoints</h4>
                <span class="text-center text-gray-600">Poeni lojalnosti</span>
            </div>
            <div class="flex flex-col flex-1 gap-3 p-4 justify-center items-center bg-red-200 rounded-xl shadow-xl font-semibold transition-all duration-200 hover:-translate-y-1">
                <i class="fa-solid fa-clipboard-list text-4xl text-orange-600"></i>
                <h4 class="text-2xl text-red-700">@Model.UpcomingOrders</h4>
                <span class="text-center text-gray-600">Predstojeće porudžbine</span>
            </div>


        </div>

        <div class="flex flex-col shadow-xl bg-red-100 rounded-xl w-full overflow-hidden transition-all duration-200 hover:-translate-y-1">
            <div class="text-red-100 gradient-red px-4 py-2 rounded-t-xl w-full flex items-center justify-between">
                <h4 class="text-red-100 font-semibold flex items-center gap-2">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    Poslednje porudžbine
                </h4>
                <a hx-get="/User/Orders" hx-target="#user-content" hx-swap="innerHTML" hx-push-url="true" class="text-xs bg-white/20 hover:bg-white/30 px-3 py-1 rounded-lg transition-colors cursor-pointer">Pogledaj sve</a>
            </div>
            <div class="divide-y divide-red-200/60">
                @if (Model.RecentOrders.Count == 0)
                {
                    <div class="p-4 text-center text-gray-500 text-sm">Nemate porudžbina.</div>
                }
                else
                {
                    @foreach (var order in Model.RecentOrders)
                    {
                        <div class="flex justify-between items-center p-3 gap-2">
                            <div class="flex flex-col">
                                <span class="font-mono font-bold text-red-800 text-sm">#@order.OrderNumber</span>
                                <span class="text-xs text-gray-500">@order.CreatedAt.ToString("dd.MM.yyyy")</span>
                            </div>
                            <span class="font-bold text-sm">@order.OrderPrice.ToString("N0") RSD</span>
                            @switch (order.OrderStatus)
                            {
                                case OrderStatus.Pending:
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200">
                                        <i class="fa-solid fa-hourglass-half text-[10px]"></i> Na čekanju
                                    </span>
                                    break;
                                case OrderStatus.Confirmed:
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                                        <i class="fa-solid fa-check text-[10px]"></i> Potvrđeno
                                    </span>
                                    break;
                                case OrderStatus.Completed:
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                        <i class="fa-solid fa-circle-check text-[10px]"></i> Završeno
                                    </span>
                                    break;
                                case OrderStatus.Cancelled:
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-300">
                                        <i class="fa-solid fa-ban text-[10px]"></i> Otkazano
                                    </span>
                                    break;
                            }
                        </div>
                    }
                }
            </div>
        </div>

    </div>

    <div class="flex flex-col w-full lg:w-[50%] gap-5">
            
        <div class="flex flex-col gap-3 p-5 shadow-xl bg-red-100 rounded-xl transition-all duration-200 hover:-translate-y-1">
            <div class="flex flex-col gap-2 justify-center items-center">
                <div class="mx-auto shadow-xl w-32 h-32 font-bold bg-orange-400 text-red-100 rounded-full flex items-center justify-center text-3xl">
                    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <img class="h-32 rounded-full object-fit w-32" src="@Model.ProfilePicture" alt="Korisnik"/>
                    }
                    else
                    {
                        @(Model.FirstName[0].ToString() + Model.LastName[0])
                    }
                </div>
            </div>
            <h4 class="text-red-900 text-xl font-semibold text-center">@Model.FirstName @Model.LastName</h4>

            <div class="flex flex-col gap-3">
                <button hx-get="/User/Profile/Settings" hx-target="#user-content" hx-swap="innerHTML" class="btn-classic gradient-red  text-white">
                    <i class="fa-solid fa-user mr-2"></i>
                    Izmeni profil
                </button>
                <button hx-get="/User/Orders" hx-target="#user-content" hx-swap="innerHTML" hx-push-url="true" class="btn-classic hover:bg-gray-200 text-gray-700">
                    <i class="fa-solid fa-box mr-2"></i>
                    Pregled porudžbina
                </button>
            </div>
        </div>
            
        <div class="flex flex-col shadow-xl bg-red-100 rounded-xl transition-all duration-200 hover:-translate-y-1">
            <div class=" text-red-100 gradient-red top-0 px-4 py-2 left-0 rounded-t-xl w-full">
                <h4 class="text-red-100">
                    <i class="fa-solid fa-info-circle mr-2"></i>
                    Status
                </h4>
            </div>
            <div class="p-2 font-semibold">
                <div class="flex w-full justify-between p-2 items-center">
                    <span class="text-gray-600">Status naloga: </span>
                    @if (@Model.Status == AccountStatus.Active)
                    {
                        <div class="badge new p-2">Aktivan</div>

                    }
                    else
                    {
                        <div class="badge out-of-stock p-2">Neaktivan</div>

                    }
                </div>
                <div class="flex w-full justify-between p-2 items-center ">
                    <span class="text-gray-600">Datum registracije:</span>
                    <span class="text-red-900">@Model.RegistrationDate</span>
                </div>
            </div>
                
                
        </div>
            
    </div>
</div>