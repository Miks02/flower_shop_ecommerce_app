@using FlowerShop.Web.Helpers
@using FlowerShop.Web.ViewModels.Components
@model ProductCardViewModel

<div class="flex justify-center flex-col shadow-2xl m-4 rounded-2xl bg-red-200 min-w-[275px] max-w-[350px] transition-all hover:shadow-all  hover:-translate-y-2 duration-200 transform-gpu">
    
    <a asp-controller="Catalogue" asp-action="Details" asp-route-id="@Model.Id" class="relative rounded-2xl cursor-pointer block">
        
        <img src="@Model.ImageUrl" alt="@Model.Name" class="object-cover w-full h-64 rounded-t-2xl">
        @if (Model.Badge is not null)
        {
            <p class="absolute top-2 right-2 p-2 @Model.BadgeColor rounded-xl shadow-md font-semibold text-sm text-white">@Model.Badge.GetDisplayName()</p>
        }

    </a>
                    
    <div class="flex flex-col p-4 gap-4 min-h-[200px]">
        <div class="w-full bg-yellow-200 rounded-md p-1 shadow-all ">
            <h5 class="text-sm text-green-900 font-semibold text-center">@Model.Category</h5>
        </div>
        <div class="flex flex-col gap-2">
            <a asp-controller="Catalogue" asp-action="Details" asp-route-id="@Model.Id" class="text-red-900 text-xl font-semibold hover:text-red-700 transition-colors">@Model.Name</a>
            <div class="flex justify-between items-center min-h-[60px]">
                <div class="flex flex-col gap-2 ">
                    @if (Model.PromoPrice != 0)
                    {
                        <p class="font-semibold text-green-700 line-through">@Model.Price RSD</p>
                        <p class="font-semibold text-red-600">@Model.PromoPrice RSD</p>
                    }
                    else
                    {
                        <p class="font-semibold text-green-700">@Model.Price RSD</p>
                    }
                    
                </div>
                <div class="flex gap-2">
                    <i class="fa-solid fa-star text-orange-500 p-0 m-0 self-center"></i>
                    <p class="mt-1 text-orange-500">@(Model.Rating > 0 ? Model.Rating : Model.Rating.ToString("0"))</p>
                </div>
            </div>
            <div class="bg-red-800 h-px w-full "></div>

        </div>
                        
        <div >
            @if (User.IsInRole("User") && Model.IsAvailable)
            {
                <form hx-post="@Url.Action("Add", "Cart")" hx-swap="none">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button
                        type="submit"
                        class="flex gap-5 items-center text-white font-semibold  bg-green-600 w-[80%] rounded-xl py-3 px-3 mx-auto shadow-all hover:scale-105 transition-all hover:opacity-80 duration-200 will-change-transform">
                        <div class="flex w-full h-full items-center justify-center gap-5 transform">
                            <h2 class="text-center">Dodaj u korpu</h2>
                            <i class="fa-solid fa-cart-plus"></i>
                        </div>
                    </button>
                </form>
            }
            else
            {
                <button 
                    disabled
                    class="flex gap-5 items-center text-white font-semibold  bg-green-600 w-[80%] rounded-xl py-3 px-3 mx-auto shadow-all hover:scale-105 transition-all hover:opacity-80 duration-200 will-change-transform disabled:opacity-70 disabled:pointer-events-none">
                    <div class="flex w-full h-full items-center justify-center gap-5 transform">
                        <h2 class="text-center">Dodaj u korpu</h2>
                        <i class="fa-solid fa-cart-plus"></i>
                    </div>
                </button>
            }
                            
        </div>

    </div>
                    
</div>